{
  "id": "com.elix.capture",
  "name": "ELIX Capture",
  "version": "1.0.0",
  "description": "Professional screen snip, video recording, and real-time visual annotation suite for ELIX OS",
  "author": {
    "name": "ELIX Media & Tooling Team",
    "email": "capture@elix.os",
    "url": "https://elix.os"
  },
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 1120,
    "height": 720,
    "minWidth": 800,
    "minHeight": 520,
    "resizable": true,
    "alwaysOnTop": false,
    "frame": false,
    "transparent": true,
    "center": true,
    "backgroundColor": "#090d18"
  },
  "permissions": [
    "fs:read",
    "fs:write",
    "ui:notification",
    "ui:dialog",
    "clipboard:read",
    "clipboard:write",
    "media:capture"
  ],
  "capabilities": {
    "capture_screen": {
      "name": "capture_screen",
      "description": "Capture high-resolution screenshot of fullscreen, active window, or custom rectangle region",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["fullscreen", "active_window", "custom_region"], "description": "Screen capture mode" },
          "regionBounds": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "delaySeconds": { "type": "number", "description": "Countdown delay before snapshot" }
        },
        "required": ["mode"]
      }
    },
    "start_screen_recording": {
      "name": "start_screen_recording",
      "description": "Initiate screen and audio recording stream with customizable framerate and quality",
      "parameters": {
        "type": "object",
        "properties": {
          "captureAudio": { "type": "boolean", "description": "Include system / mic audio" },
          "frameRate": { "type": "number", "enum": [30, 60], "description": "Target video framerate" },
          "resolutionQuality": { "type": "string", "enum": ["1080p", "720p", "4k"], "description": "Target resolution preset" }
        }
      }
    },
    "stop_screen_recording": {
      "name": "stop_screen_recording",
      "description": "Finalize active screen recording and save formatted video file to disk",
      "parameters": {
        "type": "object",
        "properties": {
          "saveFormat": { "type": "string", "enum": ["webm", "mp4", "gif"], "description": "Output video format" },
          "destinationPath": { "type": "string", "description": "Target destination file path" }
        }
      }
    },
    "apply_annotation": {
      "name": "apply_annotation",
      "description": "Apply vector arrow, callout, highlight blur, step pin, or spotlight annotation over capture",
      "parameters": {
        "type": "object",
        "properties": {
          "tool": { "type": "string", "enum": ["arrow", "text", "redact_blur", "step_pin", "rect", "spotlight"], "description": "Annotation markup tool" },
          "coordinates": { "type": "object", "description": "Start and end coordinate mapping" },
          "styling": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "strokeWidth": { "type": "number" },
              "fill": { "type": "string" }
            }
          }
        },
        "required": ["tool"]
      }
    },
    "get_capture_history": {
      "name": "get_capture_history",
      "description": "List recently captured snapshots, recordings, and exported media clips",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": { "type": "number", "description": "Maximum number of history items" },
          "filterType": { "type": "string", "enum": ["image", "video", "all"], "description": "Media type filter" }
        }
      }
    }
  }
}
