{
  "id": "com.elix.mediastudio",
  "name": "ELIX Media Studio",
  "version": "1.0.0",
  "description": "Professional creative studio for image adjustments, precision audio/video trimming, and batch format conversion in ELIX OS",
  "author": {
    "name": "ELIX Creative Labs",
    "email": "studio@elix.os",
    "url": "https://elix.os"
  },
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 1120,
    "height": 720,
    "minWidth": 800,
    "minHeight": 520,
    "resizable": true,
    "alwaysOnTop": false,
    "frame": false,
    "transparent": true,
    "center": true,
    "backgroundColor": "#090d16"
  },
  "permissions": [
    "fs:read",
    "fs:write",
    "ui:notification",
    "ui:dialog",
    "clipboard:read",
    "clipboard:write"
  ],
  "capabilities": {
    "edit_image": {
      "name": "edit_image",
      "description": "Apply real-time color grading, exposure, contrast, saturation, and blur filters.",
      "parameters": {
        "type": "object",
        "properties": {
          "sourcePath": { "type": "string", "description": "Source image path" },
          "brightness": { "type": "number", "description": "Brightness adjustment (-100 to 100)" },
          "contrast": { "type": "number", "description": "Contrast adjustment (-100 to 100)" },
          "saturation": { "type": "number", "description": "Saturation adjustment (-100 to 100)" },
          "blur": { "type": "number", "description": "Gaussian blur radius (0 to 50)" }
        },
        "required": ["sourcePath"]
      },
      "permissions": ["fs:read"]
    },
    "crop_resize": {
      "name": "crop_resize",
      "description": "Crop canvas selection and resample image dimensions.",
      "parameters": {
        "type": "object",
        "properties": {
          "sourcePath": { "type": "string", "description": "Source image path" },
          "cropRect": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "targetDimensions": {
            "type": "object",
            "properties": {
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "maintainAspectRatio": { "type": "boolean" }
        },
        "required": ["sourcePath"]
      },
      "permissions": ["fs:read"]
    },
    "trim_media": {
      "name": "trim_media",
      "description": "Trim timeline intervals on audio/video tracks with frame accuracy.",
      "parameters": {
        "type": "object",
        "properties": {
          "sourcePath": { "type": "string", "description": "Media file path" },
          "startTimestampSeconds": { "type": "number", "description": "Start timestamp in seconds" },
          "endTimestampSeconds": { "type": "number", "description": "End timestamp in seconds" },
          "outputFormat": { "type": "string", "description": "Target container format" }
        },
        "required": ["sourcePath", "startTimestampSeconds", "endTimestampSeconds"]
      },
      "permissions": ["fs:read", "fs:write"]
    },
    "convert_format": {
      "name": "convert_format",
      "description": "Transcode media assets into target formats with compression presets.",
      "parameters": {
        "type": "object",
        "properties": {
          "sourcePath": { "type": "string", "description": "Source asset path" },
          "targetFormat": { "type": "string", "enum": ["png", "jpeg", "webp", "mp4", "webm", "mp3", "wav"] },
          "qualityPreset": { "type": "string", "enum": ["high", "medium", "low"] }
        },
        "required": ["sourcePath", "targetFormat"]
      },
      "permissions": ["fs:read", "fs:write"]
    },
    "export_asset": {
      "name": "export_asset",
      "description": "Render and export finalized asset with color profile metadata.",
      "parameters": {
        "type": "object",
        "properties": {
          "destinationPath": { "type": "string", "description": "Destination file path" },
          "metadataOptions": { "type": "object" }
        },
        "required": ["destinationPath"]
      },
      "permissions": ["fs:write"]
    }
  }
}
