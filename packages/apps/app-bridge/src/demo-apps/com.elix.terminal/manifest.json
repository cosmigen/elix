{
  "id": "com.elix.terminal",
  "name": "ELIX Terminal",
  "version": "1.0.0",
  "description": "High-performance block-based terminal emulator with multi-shell process spawning and AI command assist for ELIX OS",
  "author": {
    "name": "ELIX Core Systems Team",
    "email": "terminal@elix.os",
    "url": "https://elix.os"
  },
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 1080,
    "height": 720,
    "minWidth": 760,
    "minHeight": 480,
    "resizable": true,
    "alwaysOnTop": false,
    "frame": false,
    "transparent": true,
    "center": true,
    "backgroundColor": "#070b14"
  },
  "permissions": [
    "process:spawn",
    "process:kill",
    "fs:read",
    "fs:write",
    "clipboard:read",
    "clipboard:write",
    "ui:notification"
  ],
  "capabilities": {
    "spawn_shell_session": {
      "name": "spawn_shell_session",
      "description": "Spawn a new interactive shell session (PowerShell, Command Prompt, or WSL) with designated working directory",
      "parameters": {
        "type": "object",
        "properties": {
          "shellType": { "type": "string", "enum": ["powershell", "cmd", "wsl", "bash"], "description": "Target shell executable environment" },
          "workingDirectory": { "type": "string", "description": "Initial working directory path" },
          "sessionId": { "type": "string", "description": "Unique session identifier" }
        }
      }
    },
    "execute_command": {
      "name": "execute_command",
      "description": "Execute a shell command line string within an active terminal session",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "description": "Target terminal session identifier" },
          "commandString": { "type": "string", "description": "Command line text to execute" },
          "runInBackground": { "type": "boolean", "description": "Run asynchronously without blocking prompt" }
        },
        "required": ["commandString"]
      }
    },
    "send_terminal_input": {
      "name": "send_terminal_input",
      "description": "Send raw stdin input or interrupt signal (SIGINT/Ctrl+C) to a running terminal process",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "description": "Target terminal session identifier" },
          "inputData": { "type": "string", "description": "Standard input data string" },
          "sendInterrupt": { "type": "boolean", "description": "Send SIGINT interrupt break signal" }
        }
      }
    },
    "get_session_output": {
      "name": "get_session_output",
      "description": "Retrieve stdout and stderr output stream history for a specific terminal session",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "description": "Target terminal session identifier" },
          "lineLimit": { "type": "number", "description": "Maximum number of recent output lines to return" },
          "filterRegex": { "type": "string", "description": "Optional regular expression filter" }
        }
      }
    },
    "kill_session": {
      "name": "kill_session",
      "description": "Terminate an active shell session and release underlying child process tree",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "description": "Session ID to terminate" },
          "force": { "type": "boolean", "description": "Force kill immediately (SIGKILL)" }
        },
        "required": ["sessionId"]
      }
    },
    "list_active_sessions": {
      "name": "list_active_sessions",
      "description": "Enumerate all active terminal shell sessions, process IDs, and shell types",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
