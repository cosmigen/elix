{
  "manifestVersion": "1.0",
  "appId": "com.elix.calendar",
  "name": "ELIX Calendar & Tasks",
  "version": "1.0.0",
  "description": "Modern smart calendar and tasks matrix with time-blocking and natural language scheduling for ELIX OS",
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "author": "ELIX Systems",
  "window": {
    "width": 1040,
    "height": 720,
    "minWidth": 760,
    "minHeight": 540,
    "resizable": true
  },
  "permissions": [
    {
      "permission": "ui:notification",
      "reason": "Send event and deadline reminders"
    },
    {
      "permission": "agent:memory",
      "reason": "Store tasks, agendas, and recurring events"
    }
  ],
  "capabilities": [
    {
      "name": "create_calendar_event",
      "description": "Schedule a new event in the calendar with time-blocking, categorization, and optional recurrence rules.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Title of the calendar event" },
          "startTime": { "type": "string", "description": "ISO timestamp or 24h time string (e.g. '16:00')" },
          "endTime": { "type": "string", "description": "ISO timestamp or 24h time string (e.g. '17:30')" },
          "category": { "type": "string", "enum": ["work", "personal", "deepwork", "urgent"], "description": "Category for color coding" },
          "recurrence": { "type": "string", "description": "Optional recurrence rule (DAILY, WEEKLY, etc.)" }
        },
        "required": ["title", "startTime", "endTime"]
      }
    },
    {
      "name": "add_smart_task",
      "description": "Add a task to the priority matrix with automated due-date scheduling and tag extraction.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Title or natural language task prompt" },
          "dueDate": { "type": "string", "description": "ISO date string or relative deadline expression" },
          "priority": { "type": "string", "enum": ["P1_URGENT", "P2_HIGH", "P3_MED", "P4_LOW"], "description": "Priority rating" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Organizational tags" }
        },
        "required": ["title"]
      }
    },
    {
      "name": "toggle_task_status",
      "description": "Toggle the completion state of a task by ID.",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "Unique identifier of the task" },
          "completed": { "type": "boolean", "description": "Target completion state" }
        },
        "required": ["taskId"]
      }
    },
    {
      "name": "query_agenda",
      "description": "Retrieve schedule items and tasks within a given date window.",
      "parameters": {
        "type": "object",
        "properties": {
          "startDate": { "type": "string", "description": "Start date for agenda query" },
          "endDate": { "type": "string", "description": "End date for agenda query" },
          "filterCategory": { "type": "string", "description": "Optional category filter" }
        },
        "required": []
      }
    }
  ]
}
