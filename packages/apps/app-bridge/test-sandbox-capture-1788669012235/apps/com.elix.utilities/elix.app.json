{
  "id": "com.elix.utilities",
  "name": "ELIX Utilities",
  "version": "1.0.0",
  "description": "Multi-tool Swiss army knife for developers and power users: Converter, QR Studio, Color Lab, Unicode Inspector, and Cryptographic Hasher for ELIX OS",
  "author": {
    "name": "ELIX Core Team",
    "email": "dev@elix.os",
    "url": "https://elix.os"
  },
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 980,
    "height": 680,
    "minWidth": 720,
    "minHeight": 520,
    "resizable": true,
    "alwaysOnTop": false,
    "frame": false,
    "transparent": true,
    "center": true,
    "backgroundColor": "#0b1120"
  },
  "permissions": [
    "ui:notification",
    "agent:memory",
    "clipboard:read",
    "clipboard:write"
  ],
  "capabilities": {
    "convert_units": {
      "name": "convert_units",
      "description": "Convert values across length, mass, temperature, data storage, and speed with high precision.",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["length", "mass", "temperature", "data", "speed"],
            "description": "Unit category"
          },
          "fromUnit": {
            "type": "string",
            "description": "Source unit (e.g. 'celsius', 'petabytes', 'meters', 'km/h', 'kg')"
          },
          "toUnit": {
            "type": "string",
            "description": "Target unit (e.g. 'kelvin', 'bits', 'feet', 'mph', 'pounds')"
          },
          "value": {
            "type": "number",
            "description": "Numeric value to convert"
          }
        },
        "required": [
          "category",
          "fromUnit",
          "toUnit",
          "value"
        ]
      },
      "permissions": []
    },
    "generate_qr": {
      "name": "generate_qr",
      "description": "Generate a QR code SVG/Matrix with custom error correction level and styling.",
      "parameters": {
        "type": "object",
        "properties": {
          "textPayload": {
            "type": "string",
            "description": "Text, URL, or data to encode in QR code"
          },
          "errorCorrectionLevel": {
            "type": "string",
            "enum": ["L", "M", "Q", "H"],
            "description": "Error correction resilience level"
          },
          "darkColor": {
            "type": "string",
            "description": "Hex color for dark modules"
          },
          "lightColor": {
            "type": "string",
            "description": "Hex color for background modules"
          }
        },
        "required": [
          "textPayload"
        ]
      },
      "permissions": []
    },
    "compute_hash": {
      "name": "compute_hash",
      "description": "Compute cryptographic and checksum hashes (SHA-256, SHA-512, MD5, CRC32) for string or binary payloads.",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Input text or content to hash"
          },
          "algorithm": {
            "type": "string",
            "enum": ["SHA-256", "SHA-512", "MD5", "CRC32"],
            "description": "Hashing algorithm"
          }
        },
        "required": [
          "content"
        ]
      },
      "permissions": []
    },
    "inspect_color": {
      "name": "inspect_color",
      "description": "Inspect, parse, and convert colors across HEX, RGB, HSL, and CMYK formats with WCAG contrast scoring.",
      "parameters": {
        "type": "object",
        "properties": {
          "colorInput": {
            "type": "string",
            "description": "Input color string (e.g. '#38bdf8', 'rgb(56, 189, 248)', 'hsl(199, 95%, 60%)')"
          },
          "targetFormats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Desired output color representations"
          }
        },
        "required": [
          "colorInput"
        ]
      },
      "permissions": []
    },
    "lookup_unicode": {
      "name": "lookup_unicode",
      "description": "Inspect Unicode characters, emojis, surrogate pairs, and astral plane codepoints.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Character, emoji, string, or codepoint hex (e.g. '🦄', 'U+1F984')"
          }
        },
        "required": [
          "query"
        ]
      },
      "permissions": []
    }
  }
}
