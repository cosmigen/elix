{
  "id": "com.elix.calculator",
  "name": "ELIX Calculator",
  "version": "1.0.0",
  "description": "Floating frameless calculator with expression history ledger",
  "author": {
    "name": "DeepSeek AI / ELIX Core Team",
    "email": "elix@deepseek.ai",
    "url": "https://elix.deepseek.ai"
  },
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 380,
    "height": 560,
    "minWidth": 320,
    "minHeight": 480,
    "resizable": false,
    "alwaysOnTop": true,
    "frame": false,
    "transparent": true,
    "center": true,
    "backgroundColor": "#181825"
  },
  "permissions": [
    "clipboard:read",
    "clipboard:write",
    "ui:notification"
  ],
  "capabilities": {
    "calculate": {
      "name": "calculate",
      "description": "Evaluate a mathematical expression and record in calculator ledger",
      "parameters": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "Mathematical expression to compute (e.g., '45 * 12 + 100')"
          },
          "expr": {
            "type": "string",
            "description": "Alternative alias for expression"
          }
        }
      }
    },
    "get_history": {
      "name": "get_history",
      "description": "Retrieve the computation history ledger array",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "clear_history": {
      "name": "clear_history",
      "description": "Reset calculator memory and clear the computation history ledger",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "get_last_result": {
      "name": "get_last_result",
      "description": "Get the most recent calculation expression and computed result",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  "categories": [
    "Utilities",
    "Math"
  ],
  "keywords": [
    "calculator",
    "math",
    "floating",
    "ledger"
  ]
}
