{
  "id": "com.elix.camera",
  "name": "ELIX Camera & Recorder",
  "version": "1.0.0",
  "description": "High-definition camera capture, multi-track audio/video recording, and teleprompter studio for ELIX OS",
  "author": {
    "name": "ELIX Media & Tooling Team",
    "email": "camera@elix.os",
    "url": "https://elix.os"
  },
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 1140,
    "height": 740,
    "minWidth": 820,
    "minHeight": 540,
    "resizable": true,
    "alwaysOnTop": false,
    "frame": false,
    "transparent": true,
    "center": true,
    "backgroundColor": "#070b14"
  },
  "permissions": [
    "media:camera",
    "media:microphone",
    "fs:read",
    "fs:write",
    "ui:notification",
    "ui:dialog",
    "clipboard:read",
    "clipboard:write"
  ],
  "capabilities": {
    "take_photo": {
      "name": "take_photo",
      "description": "Capture a high-resolution still photograph from the connected camera feed",
      "parameters": {
        "type": "object",
        "properties": {
          "cameraDeviceId": { "type": "string", "description": "Target camera device identifier" },
          "flashEffect": { "type": "boolean", "description": "Trigger simulated studio flash effect" },
          "countdownSeconds": { "type": "number", "enum": [0, 3, 5, 10], "description": "Self-timer countdown duration" },
          "filterPreset": { "type": "string", "enum": ["natural", "studio_glow", "warm_tone", "high_contrast_bw", "cyber_blue"], "description": "Live canvas filter shader preset" }
        }
      }
    },
    "start_video_recording": {
      "name": "start_video_recording",
      "description": "Begin recording live video and audio stream from active media devices",
      "parameters": {
        "type": "object",
        "properties": {
          "cameraDeviceId": { "type": "string", "description": "Target video input hardware ID" },
          "audioDeviceId": { "type": "string", "description": "Target audio microphone hardware ID" },
          "resolution": { "type": "string", "enum": ["1080p", "720p", "4k"], "description": "Target video resolution quality" },
          "fps": { "type": "number", "enum": [30, 60], "description": "Recording framerate" }
        }
      }
    },
    "stop_video_recording": {
      "name": "stop_video_recording",
      "description": "Stop current video recording session and export formatted video file",
      "parameters": {
        "type": "object",
        "properties": {
          "saveFormat": { "type": "string", "enum": ["webm", "mp4"], "description": "Output video container format" },
          "destinationPath": { "type": "string", "description": "Destination file path on disk" }
        }
      }
    },
    "record_audio_clip": {
      "name": "record_audio_clip",
      "description": "Record dedicated high-fidelity audio clip via connected microphone input",
      "parameters": {
        "type": "object",
        "properties": {
          "durationSeconds": { "type": "number", "description": "Audio recording duration limit" },
          "sampleRate": { "type": "number", "description": "Audio sample rate in Hz (e.g. 48000)" },
          "audioDeviceId": { "type": "string", "description": "Selected microphone hardware device ID" }
        }
      }
    },
    "list_capture_devices": {
      "name": "list_capture_devices",
      "description": "Enumerate available video cameras, microphones, and capture hardware devices",
      "parameters": {
        "type": "object",
        "properties": {
          "deviceTypeFilter": { "type": "string", "enum": ["videoinput", "audioinput", "all"], "description": "Device category filter" }
        }
      }
    },
    "toggle_teleprompter": {
      "name": "toggle_teleprompter",
      "description": "Toggle floating teleprompter script overlay with adjustable rolling text speed",
      "parameters": {
        "type": "object",
        "properties": {
          "active": { "type": "boolean", "description": "Enable or disable teleprompter HUD" },
          "textScript": { "type": "string", "description": "Script text content for rolling teleprompter" },
          "scrollSpeed": { "type": "number", "description": "Scroll rate in pixels per second" }
        }
      }
    }
  }
}
