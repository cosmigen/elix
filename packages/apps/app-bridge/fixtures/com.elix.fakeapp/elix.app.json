{
  "id": "com.elix.fakeapp",
  "name": "Fake Test App",
  "version": "1.0.0",
  "description": "End-to-end verification app",
  "author": {
    "name": "DeepSeek Test",
    "email": "test@deepseek.ai"
  },
  "entry": "dist/index.html",
  "icon": "assets/icon.svg",
  "window": {
    "width": 480,
    "height": 600,
    "resizable": true,
    "frame": false,
    "transparent": true
  },
  "permissions": ["storage:data", "ui:notification"],
  "capabilities": {
    "ping": {
      "name": "ping",
      "description": "Returns pong and active timestamp",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Optional custom message"
          }
        }
      }
    },
    "echo_test": {
      "name": "echo_test",
      "description": "Echoes back provided parameters with timestamp verification",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text payload to echo back"
          }
        }
      }
    }
  }
}
